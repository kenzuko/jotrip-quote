{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jotrip-quote",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jotrip-quote-db",
      "database_id": "REPLACE_WITH_D1_UUID",
      "migrations_dir": "migrations"
    }
  ]
}
